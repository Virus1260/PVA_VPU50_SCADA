{
  "description": "Production connection profile for Delta AS332T-A PLC over OPC UA / Modbus TCP.",
  "endpoint_url": "opc.tcp://192.168.1.100:4840",
  "security_policy": "Basic256Sha256",
  "security_mode": "SignAndEncrypt",
  "authentication": {
    "type": "username_password",
    "username_env_var": "SCADA_PLC_USER",
    "password_env_var": "SCADA_PLC_PASS"
  },
  "communication": {
    "scan_interval_ms": 250,
    "timeout_ms": 2000,
    "reconnect_delay_seconds": 5
  },
  "delta_plc": {
    "cpu": "AS332T-A",
    "ip_address": "192.168.1.100",
    "modbus_port": 502,
    "rack": 0,
    "slot": 0
  }
}
